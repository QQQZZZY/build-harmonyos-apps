{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "harmonyos": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/scripts/start-mcp.mjs"]
    },
    "deveco-code": {
      "type": "stdio",
      "command": "devecocli",
      "args": ["serve", "mcp"]
    }
  }
}
